# .env.example
# This file serves as a template for required environment variables.
# Do not place actual secrets in this file.
# Copy this file to .env.local for local development.

# Runtime Server Configuration
# HOST=0.0.0.0
# PORT=3000

# Application URL
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection
# Postgres setup in docker-compose.yml defaults to user: postgres, pass: postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cv_generator?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cv_generator_test?schema=public"

# Docker Compose DB settings (Optional, uses defaults if omitted)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=cv_generator
# POSTGRES_PORT=5432

# AI Service Configuration (Future implementation)
# GEMINI_API_KEY=your_gemini_api_key_here
